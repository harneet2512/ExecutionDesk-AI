# ==============================================================================
# ExecutionDesk AI — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Lines starting with # are comments or optional (disabled) variables.
# Required variables are uncommented with placeholder values you MUST replace.
# ==============================================================================


# ------------------------------------------------------------------------------
# Database (PostgreSQL is the default and recommended backend)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://edai:edai@localhost:5432/executiondesk
# DB_POOL_MIN=2
# DB_POOL_MAX=10


# ------------------------------------------------------------------------------
# API Security
# ------------------------------------------------------------------------------
# !!! WARNING: You MUST change these values in production !!!
# !!! Leaving the defaults exposes your application to trivial token forgery !!!
API_SECRET_KEY=CHANGE-ME-generate-a-random-64-char-string
# JWT_SECRET defaults to API_SECRET_KEY if not set. Override for key rotation.
# !!! WARNING: Must be a strong, unique secret in production !!!
# JWT_SECRET=CHANGE-ME-separate-jwt-secret
# JWT_ISSUER=executivedesk-ai
# JWT_AUDIENCE=executivedesk-ai
# JWT_EXP_MINUTES=60


# ------------------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------------------
# Set to true to enable dev auth (skips real authentication). Never in production.
# ENABLE_DEV_AUTH=false
# Set to true in pytest runs to bypass auth checks. Never in production.
# TEST_AUTH_BYPASS=false


# ------------------------------------------------------------------------------
# Governance
# ------------------------------------------------------------------------------
# Emergency kill switch — halts all order execution when true.
# KILL_SWITCH_ENABLED=false
# Comma-separated list of tradeable symbols.
# SYMBOL_ALLOWLIST=BTC,ETH,SOL
# Maximum notional value (USD) allowed per single order.
# MAX_NOTIONAL_PER_ORDER_USD=10.0
# Maximum number of trades a single run can execute.
# MAX_TRADES_PER_RUN=3
# Minimum number of research citations required before a trade proposal is valid.
# MIN_CITATIONS_REQUIRED=1


# ------------------------------------------------------------------------------
# Execution
# ------------------------------------------------------------------------------
# PAPER = simulated fills, LIVE = real orders (requires broker keys).
EXECUTION_MODE_DEFAULT=PAPER
# When true, overrides execution mode to PAPER regardless of other settings.
# FORCE_PAPER_MODE=false
# Timeout in seconds for order execution before the run is marked failed.
# EXECUTION_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------------------
# Market Data
# ------------------------------------------------------------------------------
# Market data provider. Currently only "coinbase" is supported.
# MARKET_DATA_MODE=coinbase
# Polygon.io API key — required only for stock market data.
# POLYGON_API_KEY=your-polygon-api-key-here


# ------------------------------------------------------------------------------
# Stock Data
# ------------------------------------------------------------------------------
# STOCK_DATA_PROVIDER=polygon
# STOCK_RATE_LIMIT_PER_MINUTE=5
# STOCK_WATCHLIST=AAPL,MSFT,NVDA,TSLA,SPY
# STOCK_MAX_SYMBOLS_PER_RUN=5
# STOCK_EXECUTION_MODE=ASSISTED_LIVE
# STOCK_TICKET_TTL_HOURS=24
# STOCK_LOOKBACK_DAYS_DEFAULT=10


# ------------------------------------------------------------------------------
# Coinbase CDP (Advanced Trade) — required for live crypto trading
# ------------------------------------------------------------------------------
# Obtain from https://portal.cdp.coinbase.com/
# The key name/ID from the CDP portal (e.g., "organizations/xxx/apiKeys/yyy").
COINBASE_API_KEY_NAME=your-cdp-api-key-name
# The ES256 private key in PEM format. Escape newlines as \n in a single line,
# or use COINBASE_API_PRIVATE_KEY_PATH instead (recommended).
COINBASE_API_PRIVATE_KEY=your-cdp-private-key-pem
# Path to a PEM file on disk (recommended over inline key above).
# COINBASE_API_PRIVATE_KEY_PATH=/path/to/cdp_api_key.pem

# Legacy Coinbase keys (deprecated — use CDP keys above).
# COINBASE_API_KEY=deprecated-do-not-use
# COINBASE_API_SECRET=deprecated-do-not-use


# ------------------------------------------------------------------------------
# Live Trading Safety
# ------------------------------------------------------------------------------
# Master enable for live trading. Both this AND EXECUTION_MODE_DEFAULT=LIVE
# must be set for real orders to execute.
# ENABLE_LIVE_TRADING=false
# Maximum notional value (USD) per live order.
# LIVE_MAX_NOTIONAL_USD=20.0
# Master kill switch — when true, prevents ALL live order submissions.
# TRADING_DISABLE_LIVE=true
# When set to 1, blocks ALL live executions regardless of other flags.
DEMO_SAFE_MODE=1


# ------------------------------------------------------------------------------
# Notifications (Pushover)
# ------------------------------------------------------------------------------
# PUSHOVER_ENABLED=false
# PUSHOVER_APP_TOKEN=your-pushover-app-token
# PUSHOVER_USER_KEY=your-pushover-user-key


# ------------------------------------------------------------------------------
# Observability (OpenTelemetry)
# ------------------------------------------------------------------------------
# SERVICE_NAME=executivedesk-ai
# SERVICE_VERSION=0.1.0
# OTLP endpoint for traces/metrics (e.g., http://localhost:4317).
# OTLP_ENDPOINT=http://localhost:4317
# Set to 1 to enable OpenTelemetry instrumentation.
# ENABLE_OTEL=0


# ------------------------------------------------------------------------------
# Polymarket
# ------------------------------------------------------------------------------
# POLYMARKET_API_KEY=your-polymarket-api-key
# POLYMARKET_API_SECRET=your-polymarket-api-secret
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_MAX_NOTIONAL_USD=50.0


# ------------------------------------------------------------------------------
# OpenAI — required for LLM-powered intent parsing and research
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini


# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated allowed origins. Defaults to localhost:3000-3003 for development.
# In production, set to your actual domain(s):
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com


# ------------------------------------------------------------------------------
# Middleware
# ------------------------------------------------------------------------------
# Set to 1 to enable rate limiting on API endpoints.
# ENABLE_RATE_LIMIT=0
# Set to 1 to enable audit logging of all API requests.
# ENABLE_AUDIT_LOG=0
# Set to 1 to enforce request body size limits.
# ENABLE_REQUEST_SIZE_LIMIT=0


# ------------------------------------------------------------------------------
# Diagnostics
# ------------------------------------------------------------------------------
# Set to 1 to enable verbose trade execution diagnostics in logs.
# DEBUG_TRADE_DIAGNOSTICS=0


# ==============================================================================
# Frontend (save these in frontend/.env.local, NOT in this file)
# ==============================================================================
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DEBUG_UI=0
